# EXAMPLE ONLY: replace user/group, project and cache paths before installation.
# Local-only default. For controlled LAN access use skyward-lan.service instead.
# Reviewing this repository file does not change an already installed service.
# Create cache directories owned by the service user before starting (see guides).
[Unit]
Description=Skyward LACT geometry planner (legacy name, local only)
After=network.target

[Service]
Type=simple
User=skyward
Group=skyward
WorkingDirectory=/opt/skyward
Environment=MPLCONFIGDIR=/var/cache/lact-window-planner/matplotlib
Environment=SKYWARD_CACHE_DIR=/var/cache/lact-window-planner/data
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/skyward/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/var/cache/lact-window-planner

[Install]
WantedBy=multi-user.target
